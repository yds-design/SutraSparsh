{
  "name": "sutrasparsh",
  "version": "1.0.0",
  "description": "SutraSparsh - Spiritual Wisdom Platform",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "index.ts",
  "scripts": {
    "// ------------------------------------------------": "",
    "// React Native App": "",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "// -------------------------------------------------": "",
    "// Import Engine": "",
    "importer": "npm --prefix backend/importer run dev",
    "importer:build": "npm --prefix backend/importer run build",
    "importer:start": "npm --prefix backend/importer run start",
    "importer:test": "npm --prefix backend/importer run test",
    "importer:lint": "npm --prefix backend/importer run lint",
    "importer:format": "npm --prefix backend/importer run format",
    "importer:doctor": "npm --prefix backend/importer run doctor",
    "importer:clean": "npm --prefix backend/importer run clean",
    "importer:build:clean": "npm --prefix backend/importer run build:clean",
    "// --------------------------------------------------": "",
    "// Firebase": "",
    "firebase:emulators": "firebase emulators:start",
    "// ---------------------------------------------------": "",
    "// Project": "",
    "clean": "powershell -Command \"if (Test-Path node_modules) { Remove-Item node_modules -Recurse -Force }; if (Test-Path package-lock.json) { Remove-Item package-lock.json -Force }\"",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.18.6",
    "@react-navigation/native": "^7.3.6",
    "@react-navigation/native-stack": "^7.17.8",
    "@tanstack/react-query": "^5.101.2",
    "expo": "~57.0.2",
    "expo-av": "^16.0.8",
    "expo-font": "~57.0.0",
    "expo-notifications": "~57.0.3",
    "expo-secure-store": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "express": "^5.2.1",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.3.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "^3.0.2",
    "react-native-mmkv": "^4.3.2",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.25.2",
    "react-native-svg": "^15.15.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.30.1",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3"
  }
}
