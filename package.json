{
  "name": "sutrasparsh",
  "version": "1.0.0",
  "description": "SutraSparsh - Spiritual Wisdom Platform",
  "private": true,
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "test:gate": "tsx src/testing/phase12-release-gate.ts",
    "ci:verify": "tsx scripts/ci-verify.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.18.6",
    "@react-navigation/native": "^7.3.6",
    "@react-navigation/native-stack": "^7.17.8",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.2",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "expo": "~57.0.2",
    "expo-av": "^16.0.8",
    "expo-font": "~57.0.0",
    "expo-notifications": "~57.0.3",
    "expo-secure-store": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "express": "^5.2.1",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.3.0",
    "lucide-react": "^1.37.0",
    "motion": "^13.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "^3.0.2",
    "react-native-mmkv": "^4.3.2",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.25.2",
    "react-native-svg": "^15.15.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "vite": "^8.2.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.2",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.30.1",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3"
  }
}
