# SutraSparsh Environment Configuration Template
# Documented in accordance with Phase 13 / M20.1.4 Environment Matrix

# ==========================================
# Application Identity & Mode (Required)
# ==========================================
NODE_ENV=development
APP_ENV=local
APP_NAME=SutraSparsh
APP_VERSION=1.0.0
PORT=3000

# ==========================================
# Firebase & Database Configuration (Required, Secrets Marked)
# ==========================================
FIREBASE_PROJECT_ID=sutrasparsh-dev
# SECRET: Path to JSON service account credentials
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

# ==========================================
# Security & Authorization (Required, Secrets Marked)
# ==========================================
# SECRET: Key used for Admin Operations Console and system test triggering
ADMIN_SECRET_KEY=sutrasparsh-admin-secret
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# ==========================================
# Content Ingestion & Cache Tuning (Optional / Tunable)
# ==========================================
IMPORT_BATCH_SIZE=50
IMPORT_DELAY_MS=100
CACHE_TTL_SECONDS=300
LOG_LEVEL=info

# ==========================================
# Client Firebase & Google SSO Configuration (Optional Overrides)
# ==========================================
VITE_FIREBASE_PROJECT_ID=sutrasparsh-17a55
VITE_FIREBASE_APP_ID=1:805535850231:android:dd002bc488298a2fea3df2
VITE_FIREBASE_API_KEY=AIzaSyD9uoTvdu5ghfzMlfemdCCUrcG-Kn_mRkc
VITE_FIREBASE_AUTH_DOMAIN=sutrasparsh-17a55.firebaseapp.com
VITE_FIREBASE_DATABASE_ID=(default)
VITE_FIREBASE_STORAGE_BUCKET=sutrasparsh-17a55.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=805535850231
VITE_FIREBASE_OAUTH_CLIENT_ID=805535850231-tlainhshod83bkpakigt3qj46p3ohpvc.apps.googleusercontent.com

# ==========================================
# Text-to-Speech & Audio Engine Configuration (Sprint 2.2 / 2.2A)
# ==========================================
GOOGLE_CLOUD_PROJECT_ID=sutrasparsh-dev
# Switch your TTS Provider to Bhashini ('google' or 'bhashini')
TTS_PROVIDER="bhashini"

# Bhashini ULCA Portal Credentials
VITE_BHASHINI_USER_ID="89125c11d7c54f38b3428cce7114effe"
VITE_BHASHINI_API_KEY="PASTE_COPIED_UDYAT_KEY_HERE"
VITE_BHASHINI_INFERENCE_KEY="PASTE_COPIED_INFERENCE_KEY_HERE"
VITE_BHASHINI_PIPELINE_ID="64392f96daac500b55c543d6"

# Default Voice Configurations
TTS_DEFAULT_LANGUAGE="sa"          # 'sa' for Sanskrit, 'hi' for Hindi
TTS_DEFAULT_GENDER="female"        # 'female' or 'male'
TTS_AUDIO_FORMAT="wav"             # Standard format returned by Bhashini TTS
TTS_DEFAULT_SAMPLE_RATE="22050"    # Optimal sampling rate for Bhashini TTS
TTS_DEFAULT_PACE="0.80"            # Meditative, slower cadence for shlokas

# Google Cloud TTS Optional Fallback Configuration
TTS_DEFAULT_VOICE=hi-IN-Neural2-B
TTS_DEFAULT_PROFILE=shloka_recitation
TTS_BENCHMARK_ENABLED=true
TTS_DAILY_CHARACTER_LIMIT=100000
TTS_MONTHLY_CHARACTER_LIMIT=2000000

