# SutraSparsh Environment Configuration Template
# Documented in accordance with Phase 13 / M20.1.4 Environment Matrix

# ==========================================
# Application Identity & Mode (Required)
# ==========================================
NODE_ENV=development
APP_ENV=local
APP_NAME=SutraSparsh
APP_VERSION=1.0.0
PORT=3000

# ==========================================
# Firebase & Database Configuration (Required, Secrets Marked)
# ==========================================
FIREBASE_PROJECT_ID=sutrasparsh-dev
# SECRET: Path to JSON service account credentials
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

# ==========================================
# Security & Authorization (Required, Secrets Marked)
# ==========================================
# SECRET: Key used for Admin Operations Console and system test triggering
ADMIN_SECRET_KEY=sutrasparsh-admin-secret
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# ==========================================
# Content Ingestion & Cache Tuning (Optional / Tunable)
# ==========================================
IMPORT_BATCH_SIZE=50
IMPORT_DELAY_MS=100
CACHE_TTL_SECONDS=300
LOG_LEVEL=info

# ==========================================
# Spiritual Corpus Defaults
# ==========================================
DEFAULT_LANGUAGE=sa
DEFAULT_TRANSLATION=en
